# ============================================================
# Backstage — Environment Variables
# Copy to .env.local and fill in values
# ============================================================

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_TO_EMAIL=sales@yourdomain.com

# --- Email (SMTP alternative — set EMAIL_PROVIDER=smtp) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=yourpassword

# --- Analytics ---
# Options: plausible | ga4 | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Scheduling ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
# NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-link

# --- Newsletter (Mailchimp) ---
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us1
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
MAILCHIMP_SERVER_PREFIX=us1

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://yoursite.com

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000
